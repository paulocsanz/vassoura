<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent template for vassoura.
     Do not copy this by hand: `vassoura install-daemon` writes the real plist
     (with the binary and config paths resolved) to ~/Library/LaunchAgents/
     com.vassoura.daemon.plist and prints the launchctl command. Loading it
     into the launchd session is your decision. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vassoura.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/vassoura</string>
        <string>--config</string>
        <string>~/.vassoura/config.toml</string>
        <string>daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>~/.vassoura/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>~/.vassoura/daemon.log</string>
</dict>
</plist>
